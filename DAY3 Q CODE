            System.out.println("Invalid Quantity");
            return;
        }

        switch (choice) {
            case 1:
                food = "Burger";
                price = 120;
                break;

            case 2:
                food = "Pizza";
                price = 250;
                break;

            case 3:
                food = "Sandwich";
                price = 100;
                break;

            case 4:
                food = "Pasta";
                price = 180;
                break;

            default:
                System.out.println("Invalid Choice");
                return;
        }

        System.out.println("Food: " + food);
        System.out.println("Total: Rs. " + (price * quantity));
    }
}
