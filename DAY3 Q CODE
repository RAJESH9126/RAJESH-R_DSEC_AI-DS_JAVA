Q18. Food Order Menu
java
import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int choice = sc.nextInt();
        int quantity = sc.nextInt();

        String food;
        int price;

