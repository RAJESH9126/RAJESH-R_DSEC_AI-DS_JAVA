Q15. Number Relationship

java
import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int a = sc.nextInt();
        int b = sc.nextInt();

        if (a == 0 || b == 0) {
            System.out.println("Cannot Perform Divisibility Check");
        } else {
            if (a == b) {
                System.out.println("Both Numbers are Equal");
            } else if (a > b) {
                if (a % b == 0) {
                    System.out.println(
                        "Greater Number is a Multiple of Smaller Number"
                    );
                } else {
                    System.out.println(
                        "Greater Number is Not a Multiple"
                    );
                }
            } else {
                if (b % a == 0) {
                    System.out.println(
                        "Greater Number is a Multiple of Smaller Number"
                    );
                } else {
                    System.out.println(
                        "Greater Number is Not a Multiple"
                    );
                }
            }
        }
    }
}
Q16–Q20: Switch Statements
Q16. Calculator Menu
java
import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double a = sc.nextDouble();
        double b = sc.nextDouble();
        char op = sc.next().charAt(0);

        switch (op) {
            case '+':
                System.out.printf("Result: %.1f%n", a + b);
                break;

            case '-':
                System.out.printf("Result: %.1f%n", a - b);
                break;

            case '*':
                System.out.printf("Result: %.1f%n", a * b);
                break;

            case '/':
                if (b == 0) {
                    System.out.println("Cannot Divide by Zero");
                } else {
                    System.out.printf("Result: %.1f%n", a / b);
                }
                break;

            default:
                System.out.println("Invalid Operator");
        }
    }
}
